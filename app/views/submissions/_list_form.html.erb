<%= form_for '', url: template_submissions_path(template), html: { class: 'space-y-4', autocomplete: 'off' }, data: { turbo_frame: :_top } do |f| %>
  <% submitters = template.submitters.reject { |item| item['invite_by_uuid'].present? || item['optional_invite_by_uuid'].present? || item['invite_via_field_uuid'].present? } %>
  <% submitter_uuids = submitters.pluck('uuid') %>
  <% import_list_template = {
       name: template.name,
       submitters: submitters.map { |item| item.slice('uuid', 'name') },
       fields: template.fields.select { |field| submitter_uuids.include?(field['submitter_uuid']) }
                             .map { |field| field.slice('submitter_uuid', 'name', 'type') }
     } %>

  <import-list
    data-template="<%= json_escape(import_list_template.to_json) %>"
    data-multitenant="<%= Docuseal.multitenant? %>"
    data-i18n="<%= json_escape(t('import_list').to_json) %>"
  ></import-list>

  <div id="list_form_buttons" class="hidden space-y-4">
    <div>
      <%= render('submitters_order', f:, template:) if Accounts.can_send_emails?(current_account) %>
      <%= render 'send_email', f:, template: %>
      <%= render 'extra_fields', f: %>
    </div>
    <div class="form-control">
      <%= f.button button_title(title: t('add_recipients')), class: 'base-button' %>
    </div>
  </div>
<% end %>
