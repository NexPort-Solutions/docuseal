<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-4xl font-bold"><%= t('divisions') %></h1>
      <%= link_to t('add_division'), new_settings_division_path, class: 'base-button' %>
    </div>

    <div class="space-y-4">
      <% @divisions.each do |division| %>
        <div class="border border-base-300 rounded-box p-4 flex items-start justify-between gap-4">
          <div>
            <div class="font-semibold text-lg"><%= division.branded_name %></div>
            <div class="text-sm text-gray-600"><%= division.name %></div>
            <div class="text-sm text-gray-600"><%= division.users.active.count %> <%= t('users').downcase %></div>
            <% if division.archived_at? %>
              <div class="badge badge-warning mt-2"><%= t('archived') %></div>
            <% end %>
          </div>
          <div class="flex flex-wrap gap-2 justify-end">
            <%= link_to t('edit'), edit_settings_division_path(division), class: 'btn btn-sm' %>
            <%= button_to t('support'), impersonate_settings_division_path(division), method: :post,
                          class: 'btn btn-sm btn-outline', data: { turbo: false } %>
            <% if division.archived_at? %>
              <%= button_to t('restore'), restore_settings_division_path(division), method: :post,
                            class: 'btn btn-sm btn-outline', data: { turbo: false } %>
            <% else %>
              <%= button_to t('archive'), archive_settings_division_path(division), method: :post,
                            class: 'btn btn-sm btn-outline btn-warning', data: { turbo: false } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="w-0 md:w-52"></div>
</div>
