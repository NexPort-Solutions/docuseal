<div class="form-control">
  <%= f.label :membership_role, t('account_role'), class: 'label' %>
  <%= f.select :membership_role,
               options_for_select(
                 AccountAccess::ROLES.map { |role| [t(role), role] },
                 f.object.account_access_for(current_account)&.role || AccountAccess::CONTRIBUTOR_ROLE
               ),
               {},
               class: 'base-select' %>
</div>
