<div class="flex-wrap space-y-4 md:flex md:flex-nowrap md:space-y-0 md:space-x-10">
  <%= render 'shared/admin_nav' %>
  <div class="md:flex-grow">
    <div class="flex flex-col md:flex-row md:flex-wrap gap-2 md:justify-between md:items-end mb-4 min-h-12">
      <h1 class="text-4xl font-bold"><%= t('users') %></h1>
      <%= link_to new_admin_user_path, class: 'btn btn-primary btn-md gap-2 w-full md:w-fit', data: { turbo_frame: 'modal' } do %>
        <%= svg_icon('plus', class: 'w-6 h-6') %>
        <span><%= t('new_user') %></span>
      <% end %>
    </div>
    <div class="overflow-x-auto">
      <table class="table w-full table-lg rounded-b-none overflow-hidden">
        <thead class="bg-base-200">
          <tr class="text-neutral uppercase">
            <th><%= t('name') %></th>
            <th><%= t('email') %></th>
            <th><%= t('role') %></th>
            <th><%= t('accounts') %></th>
            <th class="text-right" width="1px"></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr scope="row">
              <td><%= user.full_name %></td>
              <td><%= user.email %></td>
              <td>
                <span class="badge badge-outline whitespace-nowrap"><%= t(user.role) %></span>
                <% if user.archived_at? %>
                  <span class="badge badge-warning whitespace-nowrap mt-1"><%= t('archived') %></span>
                <% end %>
              </td>
              <td>
                <%= user.accessible_accounts.map(&:branded_name).join(', ').presence || '-' %>
              </td>
              <td class="flex items-center space-x-2 justify-end">
                <%= link_to edit_admin_user_path(user), class: 'btn btn-outline btn-xs', title: t('edit'), data: { turbo_frame: 'modal' } do %>
                  <%= t('edit') %>
                <% end %>
                <% unless user == current_user %>
                  <% if user.archived_at? %>
                    <%= button_to admin_user_path(user), method: :patch, params: { user: { archived_at: nil } }, class: 'btn btn-outline btn-xs', title: t('unarchive'),
                                  form: { data: { turbo: false }, onsubmit: "return confirm('#{j t('are_you_sure_')}')" } do %>
                      <%= t('unarchive') %>
                    <% end %>
                  <% else %>
                    <%= button_to admin_user_path(user), method: :delete, class: 'btn btn-outline btn-error btn-xs', title: t('archive'),
                                  form: { data: { turbo: false }, onsubmit: "return confirm('#{j t('are_you_sure_')}')" } do %>
                      <%= t('archive') %>
                    <% end %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
