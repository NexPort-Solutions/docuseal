<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0 md:space-x-10">
  <%= render 'shared/admin_nav' %>
  <div class="flex-grow max-w-xl mx-auto">
    <h1 class="text-4xl font-bold mb-4"><%= t('application') %></h1>
    <%= form_for @encrypted_config, url: admin_application_settings_path, method: :patch, html: { autocomplete: 'off', class: 'space-y-4' } do |f| %>
      <div class="form-control">
        <%= f.label :value, t('app_url'), class: 'label' %>
        <%= text_field_tag 'global_encrypted_config[value]', @config_value, autocomplete: 'off', class: 'base-input' %>
      </div>
      <div class="form-control pt-2">
        <%= f.button button_title(title: t('save'), disabled_with: t('saving')), class: 'base-button' %>
      </div>
    <% end %>
  </div>
</div>
