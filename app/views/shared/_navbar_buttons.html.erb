<% if signed_in? && current_user != true_user %>
  <%= render 'shared/test_alert' %>
<% elsif request.path.starts_with?('/settings') && current_user&.platform_admin? %>
  <%= link_to settings_divisions_path, class: 'hidden md:inline-flex btn btn-warning btn-sm', data: { prefetch: false } do %>
    <%= t('divisions') %>
  <% end %>
  <span class="hidden md:inline-flex h-3 border-r border-base-content"></span>
<% end %>
