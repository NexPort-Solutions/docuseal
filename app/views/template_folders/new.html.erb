<%= render 'shared/turbo_modal', title: t('new_folder', default: 'New Folder') do %>
  <%= form_for @template_folder, url: folders_path, data: { turbo_frame: :_top }, html: { autocomplete: :off } do |f| %>
    <%= hidden_field_tag :account_id, current_account.id %>
    <%= hidden_field_tag :parent_folder_id, @parent_folder&.id %>

    <div class="form-control my-6">
      <%= f.text_field :name, required: true, placeholder: "#{t('folder_name')}...", class: 'base-input w-full', autofocus: true, dir: 'auto' %>
    </div>
    <div class="form-control">
      <%= f.button button_title(title: t('create'), disabled_with: t('creating')), class: 'base-button' %>
    </div>
  <% end %>
<% end %>
